{
  "id": "ecommerce_checkout_flow",
  "instruction": "Buy items and check out. Search 'laptop' (type it in the search box, click Search), add 'Laptop Pro'. Then click the 'Accessories' filter, add 'Wireless Mouse' and 'USB Hub'. Click 'View Cart', then 'Proceed to Shipping': name 'Jordan Lee', address '100 Granville St', city 'Vancouver', country 'Canada', postal 'V6Z 1L3', phone '+1-604-555-0100', method 'Express', click 'Next: Payment'. Card '4111111111111111', expiry '12/27', CVV '123', name 'Jordan Lee'. Uncheck 'Billing address same as shipping', billing name 'Dana Lee', billing address '5 Water St', billing city 'Vancouver'. Click 'Place Order'.",
  "difficulty": "hard",
  "html": "<script>\nvar D={};\nfunction toggle(id){var m=document.getElementById('menu-'+id);m.style.display=(m.style.display==='none')?'block':'none';}\nfunction pick(id,v){D[id]=v;var b=document.getElementById('dd-'+id);if(b)b.textContent=v;var m=document.getElementById('menu-'+id);if(m)m.style.display='none';}\nfunction show(id){var ps=document.querySelectorAll('.page');for(var i=0;i<ps.length;i++){ps[i].style.display='none';}var t=document.getElementById(id);if(t)t.style.display='block';}\nfunction val(id){var e=document.getElementById(id);return e?e.value.trim():'';}\nfunction radioVal(name){var r=document.querySelector('input[name=\"'+name+'\"]:checked');return r?r.value:'';}\nfunction groupChecked(name){var a=[];var cs=document.querySelectorAll('input[name=\"'+name+'\"]:checked');for(var i=0;i<cs.length;i++)a.push(cs[i].value);return a.join(',');}\nfunction boxChecked(id){var e=document.getElementById(id);return e&&e.checked?'yes':'no';}\n</script><div style='font-family:sans-serif'><div class='page' id='store' style='display:none'><input id='query' placeholder='Search products'><button onclick=\"setQuery()\">Search</button><div id='filters'><button onclick=\"setCat('electronics')\">Electronics</button><button onclick=\"setCat('accessories')\">Accessories</button><button onclick=\"setCat('all')\">All</button></div><div id='catalog'></div><div>Cart: <span id='cartcount'>0</span></div><button onclick=\"show('cart')\">View Cart</button></div><div class='page' id='cart' style='display:none'><h2>Cart</h2><div id='cartitems'></div><button onclick=\"show('shipping')\">Proceed to Shipping</button></div><div class='page' id='shipping' style='display:none'><h2>Shipping</h2><input id='ship_name' placeholder='Full name'><input id='ship_address' placeholder='Address'><input id='ship_city' placeholder='City'><div class='dd'><button id='dd-ship_country' onclick=\"toggle('ship_country')\">Select country</button><div id='menu-ship_country' style='display:none'><button class='opt' data-dd='ship_country' data-v='United States' onclick=\"pick('ship_country','United States')\">United States</button><button class='opt' data-dd='ship_country' data-v='Canada' onclick=\"pick('ship_country','Canada')\">Canada</button><button class='opt' data-dd='ship_country' data-v='Mexico' onclick=\"pick('ship_country','Mexico')\">Mexico</button></div></div><input id='ship_postal' placeholder='Postal code'><input id='ship_phone' placeholder='Phone'><input type='radio' name='ship_method' value='Standard' aria-label='Standard'><input type='radio' name='ship_method' value='Express' aria-label='Express'><button onclick=\"show('payment')\">Next: Payment</button></div><div class='page' id='payment' style='display:none'><h2>Payment</h2><input id='card' placeholder='Card number'><input id='expiry' placeholder='Expiry (MM/YY)'><input id='cvv' placeholder='CVV'><input id='card_name' placeholder='Name on card'><input type='checkbox' id='bill_same' name='bill_same' value='yes' aria-label='Billing address same as shipping' checked><div id='billfields' style='display:none'><input id='bill_name' placeholder='Billing name'><input id='bill_address' placeholder='Billing address'><input id='bill_city' placeholder='Billing city'></div><button onclick=\"var s='Order ORD-8842 confirmed: '+cart.join(', ')+' | ship='+val('ship_name')+' | method='+radioVal('ship_method')+' | bill_same='+boxChecked('bill_same')+' | bill='+val('bill_name')+','+val('bill_city');document.getElementById('summary').textContent=s;\">Place Order</button></div><div id='summary'></div><script>var PRODUCTS=[{n:'Laptop Pro',c:'electronics'},{n:'Smartphone X',c:'electronics'},{n:'Wireless Mouse',c:'accessories'},{n:'USB Hub',c:'accessories'},{n:'Desk Lamp',c:'accessories'}];var cart=[];var q='';var c='all';function renderCatalog(){var h='';for(var i=0;i<PRODUCTS.length;i++){var mc=(c==='all'||PRODUCTS[i].c===c);var mq=(!q||PRODUCTS[i].n.toLowerCase().indexOf(q)>=0);if(mc&&mq){h+='<div>'+PRODUCTS[i].n+' <button onclick=\"add('+i+')\">Add</button></div>';}}document.getElementById('catalog').innerHTML=h;}function setQuery(){q=document.getElementById('query').value.toLowerCase();renderCatalog();}function setCat(x){c=x;q='';document.getElementById('query').value='';renderCatalog();}function add(i){cart.push(PRODUCTS[i].n);document.getElementById('cartcount').textContent=cart.length;document.getElementById('cartitems').innerHTML=cart.join(', ');}function updateBill(){document.getElementById('billfields').style.display=document.getElementById('bill_same').checked?'none':'block';}document.getElementById('bill_same').addEventListener('change',updateBill);renderCatalog();show('store');</script></div>",
  "max_steps": 45,
  "evaluator": {
    "func": "contains",
    "result": {
      "getter": "element_text",
      "selector": "#summary"
    },
    "expected": {
      "expected": [
        "Order ORD-8842 confirmed",
        "Laptop Pro, Wireless Mouse, USB Hub",
        "ship=Jordan Lee",
        "method=Express",
        "bill_same=no",
        "bill=Dana Lee,Vancouver"
      ]
    }
  }
}
