{
  "id": "validate_password_match",
  "difficulty": "hard",
  "instruction": "Create an account with email 'ada@example.com' and password 's3curepass' (entered in both the password and confirm fields). All three validations must pass and the page must show 'Account created'.",
  "html": "<input id=\"email\" placeholder=\"Email\"><input id=\"pw\" type=\"password\" placeholder=\"Password\"><input id=\"pw2\" type=\"password\" placeholder=\"Confirm password\"><button id=\"go\" onclick=\"submit()\">Create account</button><div id=\"errors\"></div><div id=\"ok\" style=\"display:none\">Account created</div><script>function submit(){var e = document.getElementById(\"email\").value.trim();var p = document.getElementById(\"pw\").value;var p2 = document.getElementById(\"pw2\").value;var errs = [];if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(e)) errs.push(\"Invalid email\");if (p.length < 8) errs.push(\"Password must be at least 8 characters\");if (p !== p2) errs.push(\"Passwords do not match\");document.getElementById(\"errors\").textContent = errs.join(\"; \");document.getElementById(\"ok\").style.display = errs.length ? \"none\" : \"block\";}</script>",
  "evaluator": {
    "func": "contains",
    "result": {
      "getter": "page_text"
    },
    "expected": {
      "include": [
        "Account created"
      ],
      "exclude": [
        "Invalid email",
        "at least 8",
        "do not match"
      ]
    }
  }
}
