  "instruction": "Fill the form: city 'Paris', country 'France', age '30'. Click Submit. Then click 'Confirm Order' and verify 'Order confirmed' appears.",
  "html": "<div id=\"page1\"><input id=\"city\" placeholder=\"city\"><select id=\"country\"><option>France</option><option>Other</option></select><input id=\"age\" placeholder=\"age\"><button id=\"submit\" onclick=\"s()\">Submit</button></div><div id=\"page2\" style=\"display:none\"><p>Form submitted.</p><button id=\"fin\" onclick=\"f()\">Confirm Order</button></div><div id=\"out\"></div><script>function s(){if(document.getElementById('city').value===\"Paris\" && document.getElementById('country').value===\"France\" && document.getElementById('age').value===\"30\"){document.getElementById(\"page1\").style.display=\"none\";document.getElementById(\"page2\").style.display=\"block\";}}function f(){document.getElementById(\"out\").textContent=\"Order confirmed\";}</script>",
  "evaluator": {
    "func": "exact_match",
    "result": {
      "getter": "element_text",
      "selector": "#out"
    },
    "expected": {
      "expected": "Order confirmed"
    }
  }
}
