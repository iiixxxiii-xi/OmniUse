  "html": "<div id=\"page1\"><input id=\"first\" placeholder=\"first name\"><input id=\"last\" placeholder=\"last name\"><input id=\"phone\" placeholder=\"phone\"><button id=\"submit\" onclick=\"s()\">Submit</button></div><div id=\"page2\" style=\"display:none\"><p>Form submitted.</p><button id=\"fin\" onclick=\"f()\">Generate Report</button></div><div id=\"out\"></div><script>function s(){if(document.getElementById('first').value===\"John\" && document.getElementById('last').value===\"Doe\" && document.getElementById('phone').value===\"555-0100\"){document.getElementById(\"page1\").style.display=\"none\";document.getElementById(\"page2\").style.display=\"block\";}}function f(){document.getElementById(\"out\").textContent=\"Report ready\";}</script>",
