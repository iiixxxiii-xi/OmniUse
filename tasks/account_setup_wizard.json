{
  "id": "account_setup_wizard",
  "instruction": "Complete the 5-step account setup. Step 1: title 'Ms', full name 'Alice Johnson', email 'alice@example.com', username 'alicej', password 'S3cure!Pass' (twice), Next. Step 2: date of birth '1992-08-15', gender 'Female', country 'Canada', phone '+1-555-0100', check 'English' and 'Spanish' languages, bio 'Designer based in Toronto', Next. Step 3: street '42 Maple Ave', apt 'Unit 3', city 'Toronto', province 'Ontario', postal 'M5V 2T6', website 'alice.dev', Next. Step 4: check interests 'Technology', 'Music', 'Travel', check the newsletter box, plan 'Pro', theme 'Dark', notifications 'Email', timezone 'UTC-5', Next. Step 5: click 'Create Account'.",
  "difficulty": "hard",
  "html": "<script>\nvar D={};\nfunction toggle(id){var m=document.getElementById('menu-'+id);m.style.display=(m.style.display==='none')?'block':'none';}\nfunction pick(id,v){D[id]=v;var b=document.getElementById('dd-'+id);if(b)b.textContent=v;var m=document.getElementById('menu-'+id);if(m)m.style.display='none';}\nfunction show(id){var ps=document.querySelectorAll('.page');for(var i=0;i<ps.length;i++){ps[i].style.display='none';}var t=document.getElementById(id);if(t)t.style.display='block';}\nfunction val(id){var e=document.getElementById(id);return e?e.value.trim():'';}\nfunction radioVal(name){var r=document.querySelector('input[name=\"'+name+'\"]:checked');return r?r.value:'';}\nfunction groupChecked(name){var a=[];var cs=document.querySelectorAll('input[name=\"'+name+'\"]:checked');for(var i=0;i<cs.length;i++)a.push(cs[i].value);return a.join(',');}\nfunction boxChecked(id){var e=document.getElementById(id);return e&&e.checked?'yes':'no';}\n</script><div style='font-family:sans-serif'><div class='page' id='page1' style='display:none'><h2>Step 1: Account</h2><div class='dd'><button id='dd-title' onclick=\"toggle('title')\">Select title</button><div id='menu-title' style='display:none'><button class='opt' data-dd='title' data-v='Mr' onclick=\"pick('title','Mr')\">Mr</button><button class='opt' data-dd='title' data-v='Ms' onclick=\"pick('title','Ms')\">Ms</button><button class='opt' data-dd='title' data-v='Dr' onclick=\"pick('title','Dr')\">Dr</button><button class='opt' data-dd='title' data-v='Mx' onclick=\"pick('title','Mx')\">Mx</button></div></div><input id='fullname' placeholder='Full name'><input id='email' placeholder='Email'><input id='username' placeholder='Username'><input id='password' placeholder='Password'><input id='confirm' placeholder='Confirm password'><div id='err1' style='color:red'></div><button onclick=\"if(!val('password')||val('password')!==val('confirm')){document.getElementById('err1').textContent='Passwords do not match';}else{show('page2');}\">Next</button></div><div class='page' id='page2' style='display:none'><h2>Step 2: Personal</h2><input id='dob' placeholder='Date of birth (YYYY-MM-DD)'><input type='radio' name='gender' value='Female' aria-label='Female'><input type='radio' name='gender' value='Male' aria-label='Male'><input type='radio' name='gender' value='Other' aria-label='Other'><div class='dd'><button id='dd-country' onclick=\"toggle('country')\">Select country</button><div id='menu-country' style='display:none'><button class='opt' data-dd='country' data-v='United States' onclick=\"pick('country','United States')\">United States</button><button class='opt' data-dd='country' data-v='Canada' onclick=\"pick('country','Canada')\">Canada</button><button class='opt' data-dd='country' data-v='United Kingdom' onclick=\"pick('country','United Kingdom')\">United Kingdom</button><button class='opt' data-dd='country' data-v='Germany' onclick=\"pick('country','Germany')\">Germany</button></div></div><input id='phone' placeholder='Phone'><input type='checkbox' id='lang_en' name='languages' value='English' aria-label='English'><input type='checkbox' id='lang_fr' name='languages' value='French' aria-label='French'><input type='checkbox' id='lang_es' name='languages' value='Spanish' aria-label='Spanish'><input type='checkbox' id='lang_zh' name='languages' value='Mandarin' aria-label='Mandarin'><textarea id='bio' placeholder='Short bio'></textarea><button onclick=\"show('page3')\">Next</button></div><div class='page' id='page3' style='display:none'><h2>Step 3: Address</h2><input id='street' placeholder='Street address'><input id='apt' placeholder='Apt / unit'><input id='city' placeholder='City'><div class='dd'><button id='dd-province' onclick=\"toggle('province')\">Select province</button><div id='menu-province' style='display:none'><button class='opt' data-dd='province' data-v='Ontario' onclick=\"pick('province','Ontario')\">Ontario</button><button class='opt' data-dd='province' data-v='British Columbia' onclick=\"pick('province','British Columbia')\">British Columbia</button><button class='opt' data-dd='province' data-v='Quebec' onclick=\"pick('province','Quebec')\">Quebec</button><button class='opt' data-dd='province' data-v='Alberta' onclick=\"pick('province','Alberta')\">Alberta</button></div></div><input id='postal' placeholder='Postal code'><input id='website' placeholder='Website'><button onclick=\"show('page4')\">Next</button></div><div class='page' id='page4' style='display:none'><h2>Step 4: Preferences</h2><input type='checkbox' id='int_tech' name='interests' value='Technology' aria-label='Technology'><input type='checkbox' id='int_music' name='interests' value='Music' aria-label='Music'><input type='checkbox' id='int_sports' name='interests' value='Sports' aria-label='Sports'><input type='checkbox' id='int_travel' name='interests' value='Travel' aria-label='Travel'><input type='checkbox' id='int_gaming' name='interests' value='Gaming' aria-label='Gaming'><input type='checkbox' id='newsletter' name='newsletter' value='yes' aria-label='Subscribe to newsletter'><input type='radio' name='plan' value='Free' aria-label='Free'><input type='radio' name='plan' value='Pro' aria-label='Pro'><input type='radio' name='plan' value='Enterprise' aria-label='Enterprise'><div class='dd'><button id='dd-theme' onclick=\"toggle('theme')\">Select theme</button><div id='menu-theme' style='display:none'><button class='opt' data-dd='theme' data-v='Light' onclick=\"pick('theme','Light')\">Light</button><button class='opt' data-dd='theme' data-v='Dark' onclick=\"pick('theme','Dark')\">Dark</button><button class='opt' data-dd='theme' data-v='System' onclick=\"pick('theme','System')\">System</button></div></div><div class='dd'><button id='dd-notifications' onclick=\"toggle('notifications')\">Select notifications</button><div id='menu-notifications' style='display:none'><button class='opt' data-dd='notifications' data-v='Email' onclick=\"pick('notifications','Email')\">Email</button><button class='opt' data-dd='notifications' data-v='SMS' onclick=\"pick('notifications','SMS')\">SMS</button><button class='opt' data-dd='notifications' data-v='None' onclick=\"pick('notifications','None')\">None</button></div></div><div class='dd'><button id='dd-timezone' onclick=\"toggle('timezone')\">Select timezone</button><div id='menu-timezone' style='display:none'><button class='opt' data-dd='timezone' data-v='UTC-8' onclick=\"pick('timezone','UTC-8')\">UTC-8</button><button class='opt' data-dd='timezone' data-v='UTC-5' onclick=\"pick('timezone','UTC-5')\">UTC-5</button><button class='opt' data-dd='timezone' data-v='UTC+0' onclick=\"pick('timezone','UTC+0')\">UTC+0</button><button class='opt' data-dd='timezone' data-v='UTC+8' onclick=\"pick('timezone','UTC+8')\">UTC+8</button></div></div><button onclick=\"show('page5')\">Next</button></div><div class='page' id='page5' style='display:none'><h2>Step 5: Review</h2><p>Review your details and submit.</p><button onclick=\"var s='title='+D['title']+'|name='+val('fullname')+'|email='+val('email')+'|username='+val('username')+'|dob='+val('dob')+'|gender='+radioVal('gender')+'|country='+D['country']+'|phone='+val('phone')+'|languages='+groupChecked('languages')+'|bio='+val('bio')+'|street='+val('street')+'|apt='+val('apt')+'|city='+val('city')+'|province='+D['province']+'|postal='+val('postal')+'|website='+val('website')+'|interests='+groupChecked('interests')+'|newsletter='+boxChecked('newsletter')+'|plan='+radioVal('plan')+'|theme='+D['theme']+'|notifications='+D['notifications']+'|timezone='+D['timezone'];document.getElementById('summary').textContent=s;\">Create Account</button></div><div id='summary'></div><script>show('page1');</script></div>",
  "max_steps": 50,
  "evaluator": {
    "func": "contains",
