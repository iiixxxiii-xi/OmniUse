{
  "id": "project_setup_crud",
  "instruction": "Create a project end-to-end. Step 1: name 'Atlas Dashboard', description 'Internal metrics', type 'Web', start '2024-03-01', end '2024-09-30'; Next. Step 2: add member 1 name 'Sam Wu', email 'sam@example.com', role 'Admin', click 'Add member'; add member 2 name 'Priya Nair', email 'priya@example.com', role 'Editor', click 'Add member'; Next. Step 3: check integrations 'GitHub', 'Slack', 'Drive' (leave 'Jira' off); click 'Create Project'.",
  "difficulty": "hard",
  "html": "<script>\nvar D={};\nfunction toggle(id){var m=document.getElementById('menu-'+id);m.style.display=(m.style.display==='none')?'block':'none';}\nfunction pick(id,v){D[id]=v;var b=document.getElementById('dd-'+id);if(b)b.textContent=v;var m=document.getElementById('menu-'+id);if(m)m.style.display='none';}\nfunction show(id){var ps=document.querySelectorAll('.page');for(var i=0;i<ps.length;i++){ps[i].style.display='none';}var t=document.getElementById(id);if(t)t.style.display='block';}\nfunction val(id){var e=document.getElementById(id);return e?e.value.trim():'';}\nfunction radioVal(name){var r=document.querySelector('input[name=\"'+name+'\"]:checked');return r?r.value:'';}\nfunction groupChecked(name){var a=[];var cs=document.querySelectorAll('input[name=\"'+name+'\"]:checked');for(var i=0;i<cs.length;i++)a.push(cs[i].value);return a.join(',');}\nfunction boxChecked(id){var e=document.getElementById(id);return e&&e.checked?'yes':'no';}\n</script><div style='font-family:sans-serif'><div class='page' id='page1' style='display:none'><h2>Project basics</h2><input id='p_name' placeholder='Project name'><input id='p_desc' placeholder='Description'><div class='dd'><button id='dd-p_type' onclick=\"toggle('p_type')\">Select type</button><div id='menu-p_type' style='display:none'><button class='opt' data-dd='p_type' data-v='Web' onclick=\"pick('p_type','Web')\">Web</button><button class='opt' data-dd='p_type' data-v='Mobile' onclick=\"pick('p_type','Mobile')\">Mobile</button><button class='opt' data-dd='p_type' data-v='Data' onclick=\"pick('p_type','Data')\">Data</button><button class='opt' data-dd='p_type' data-v='API' onclick=\"pick('p_type','API')\">API</button></div></div><input id='p_start' placeholder='Start date (YYYY-MM-DD)'><input id='p_end' placeholder='End date (YYYY-MM-DD)'><button onclick=\"show('page2')\">Next</button></div><div class='page' id='page2' style='display:none'><h2>Team</h2><input id='m1_name' placeholder='Member name'><input id='m1_email' placeholder='Member email'><div class='dd'><button id='dd-m1_role' onclick=\"toggle('m1_role')\">Select role</button><div id='menu-m1_role' style='display:none'><button class='opt' data-dd='m1_role' data-v='Owner' onclick=\"pick('m1_role','Owner')\">Owner</button><button class='opt' data-dd='m1_role' data-v='Admin' onclick=\"pick('m1_role','Admin')\">Admin</button><button class='opt' data-dd='m1_role' data-v='Editor' onclick=\"pick('m1_role','Editor')\">Editor</button><button class='opt' data-dd='m1_role' data-v='Viewer' onclick=\"pick('m1_role','Viewer')\">Viewer</button></div></div><button id='add1' onclick=\"addMember('m1_name','m1_email','m1_role')\">Add member</button><input id='m2_name' placeholder='Member name'><input id='m2_email' placeholder='Member email'><div class='dd'><button id='dd-m2_role' onclick=\"toggle('m2_role')\">Select role</button><div id='menu-m2_role' style='display:none'><button class='opt' data-dd='m2_role' data-v='Owner' onclick=\"pick('m2_role','Owner')\">Owner</button><button class='opt' data-dd='m2_role' data-v='Admin' onclick=\"pick('m2_role','Admin')\">Admin</button><button class='opt' data-dd='m2_role' data-v='Editor' onclick=\"pick('m2_role','Editor')\">Editor</button><button class='opt' data-dd='m2_role' data-v='Viewer' onclick=\"pick('m2_role','Viewer')\">Viewer</button></div></div><button id='add2' onclick=\"addMember('m2_name','m2_email','m2_role')\">Add member</button><div id='teamlist'></div><button onclick=\"show('page3')\">Next</button></div><div class='page' id='page3' style='display:none'><h2>Integrations</h2><input type='checkbox' id='i_github' name='integrations' value='GitHub' aria-label='GitHub'><input type='checkbox' id='i_slack' name='integrations' value='Slack' aria-label='Slack'><input type='checkbox' id='i_jira' name='integrations' value='Jira' aria-label='Jira'><input type='checkbox' id='i_drive' name='integrations' value='Drive' aria-label='Drive'><button onclick=\"var s='project='+val('p_name')+'|type='+D['p_type']+'|start='+val('p_start')+'|end='+val('p_end')+'|members='+members.length+'|roles='+roles.join(',')+'|integrations='+groupChecked('integrations');document.getElementById('summary').textContent=s;\">Create Project</button></div><div id='summary'></div><script>var members=[];var roles=[];function addMember(nid,eid,rid){var n=val(nid);var e=val(eid);var r=D[rid];if(!n||!e||!r)return;members.push(n);roles.push(r);document.getElementById('teamlist').innerHTML=members.map(function(m,i){return '<div>'+m+' ('+roles[i]+')</div>';}).join('');}show('page1');</script></div>",
  "max_steps": 45,
  "evaluator": {
    "func": "contains",
    "result": {
      "getter": "element_text",
      "selector": "#summary"
    },
    "expected": {
      "expected": [
        "project=Atlas Dashboard",
        "type=Web",
        "start=2024-03-01",
        "end=2024-09-30",
        "members=2",
        "roles=Admin,Editor",
        "integrations=GitHub,Slack,Drive"
      ]
    }
  }
}
